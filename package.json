{
  "name": "dime",
  "private": true,
  "version": "0.1.0",
  "description": "DIME — design system de dianamendozacruz.com",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "storybook": "npm run tokens && storybook dev -p 6006 --no-open",
    "build-storybook": "npm run tokens && storybook build",
    "test": "vitest run --project storybook",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "gate": "npm run check:tokens && npm run check:docs && npm run test && npm run build-storybook"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/html-vite": "^10.6.7",
    "@storybook/icons": "^2.2.0",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "vitest": "^4.1.12"
  }
}
